
# Server
SERVER_PORT=8080
GIN_MODE=release   # release, debug, test
# APP_ENV=local    # local | staging | production (loads .env.{APP_ENV})

# Database — prefer DATABASE_URL (used by app and make migrate-up)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shopping_platform?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shopping_platform
DB_SSLMODE=disable
# DB_MAX_OPEN_CONNS=100
# DB_MAX_IDLE_CONNS=10

# JWT
JWT_SECRET=change_this_to_a_strong_secret_in_production

# Logging
LOG_LEVEL=info    # debug, info, warn, error, fatal, panic

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@yourapp.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Redis (Phase 2 — background jobs / cache)
# REDIS_URL=redis://localhost:6379/0

# Stripe (sandbox keys for dev — use Dashboard → Developers → Webhooks for STRIPE_WEBHOOK_SECRET)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# CORS (comma-separated origins; leave empty to use dev defaults incl. Next.js + Expo web)
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081