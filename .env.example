
# Server
SERVER_PORT=8080
GIN_MODE=release   # release, debug, test
# APP_ENV=local    # local | staging | production (loads .env.{APP_ENV})

# Database — prefer DATABASE_URL (used by app and make migrate-up)
# Defaults: docker-psql_bp-1 container (user alirezas). Use a dedicated DB for luxe-backend —
# NOT the ecom-go `ecom` database (different schema).
DB_HOST=localhost
DB_PORT=5432
DB_USER=alirezas
DB_PASSWORD=
DB_NAME=shopping_platform
DB_SSLMODE=disable
# DB_MAX_OPEN_CONNS=100
# DB_MAX_IDLE_CONNS=10

# JWT
JWT_SECRET=change_this_to_a_strong_secret_in_production

# Logging
LOG_LEVEL=info    # debug, info, warn, error, fatal, panic
# SERVICE_NAME=luxe-api
# SERVICE_VERSION=1.0.0

# Observability — structured JSON logs go to stdout (ship to Loki/ELK/Datadog via Fluent Bit, Vector, etc.)
# Sentry — https://docs.sentry.io/platforms/go/guides/gin/
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry tracing (optional — requires a collector e.g. Jaeger on :4318)
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@yourapp.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=BC9Ip6GTPJls_fJX2LHd32KfjM6HqK7mlaFvl_CRw9JNXB1HHkB0J1E15kxmzWcqvebniDd7CRlubjacWfJfWnE
# VAPID_PRIVATE_KEY=5SXXDNB7MShO4YDY5A6G-0beWigxRNnuvFBtHbieeQk
# VAPID_SUBJECT=mailto:noreply@yourapp.com

# AI (LLM) — Ollama local by default; swap provider via env only
# AI_ENABLED=true
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.2
# AI_MAX_REQUESTS_PER_HOUR=20
# AI_CHAT_MAX_REQUESTS_PER_HOUR=30

# Inventory alerts — comma-separated ops emails (falls back to admin user emails when empty)
# INVENTORY_ALERT_EMAILS=ops@yourcompany.com,warehouse@yourcompany.com

# Redis (background jobs via Asynq — omit for in-memory fallback)
# REDIS_URL=redis://localhost:6379/0

# Stripe (sandbox keys for dev — use Dashboard → Developers → Webhooks for STRIPE_WEBHOOK_SECRET)
# Wallet deposits and order checkout use Stripe Checkout when keys are set.
# Subscribe webhook to: checkout.session.completed, checkout.session.expired
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# CORS (comma-separated origins; leave empty to use dev defaults incl. Next.js + Expo web)
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081

# Cloudflare R2 — presigned direct uploads (all vars required to enable)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=luxe-media
# R2_PUBLIC_BASE_URL=https://media.yourdomain.com
# R2_PRESIGN_TTL=15m
# R2_MAX_UPLOAD_MB=10